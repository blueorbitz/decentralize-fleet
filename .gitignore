# Secrets. Never commit these.
.env
.env.*
!.env.example

# Local workspaces the worker clones into.
.fleet/

# Dependencies and build output.
node_modules/
dist/

# Logs from worker runs.
*.log

# Capture artefacts: the saved Jira session is a credential, and the raw takes
# and worker logs contain the real tenant address and bot account. They are
# regenerated from the tenant, so nothing under public/ belongs in git.
#
# src/capture.json is generated by the capture scripts and names the real tenant
# URLs; src/capture.example.json is the committed shape.
demo/.auth/
demo/public/
demo/src/capture.json

# Remotion build output and review stills.
demo/out/
demo/.remotion/

# A checked-out worker workspace, cloned from the real remote.
fleet-repo/fleet-test/
