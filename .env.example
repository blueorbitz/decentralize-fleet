# --- Local secrets and configuration ---------------------------------------
# One .env for the whole repo. The worker reads it; the Forge app does not
# (it reads `forge variables set` — see forge-app/README.md).
#
# Copy to .env and fill in:   Copy-Item .env.example .env
# Never commit .env — it is git-ignored. This example file is the one to commit.

# ===========================================================================
# Jira — required by the worker and all operator scripts.
# ===========================================================================

# Your site, no trailing slash.
JIRA_URL=https://your-site.atlassian.net

# The Fleet Bot account. A Jira API token inherits its permissions from the
# account that created it, so this must be the BOT's token, not an admin's.
#   https://id.atlassian.com/manage/api-tokens
JIRA_EMAIL=fleet-bot@your-domain.com
JIRA_TOKEN=

# Project key and base branch are optional; the defaults are below.
JIRA_PROJECT=FLT

# ===========================================================================
# Provisioning only — needs the *Administer Jira* global permission.
# Only `npm run provision` (in forge-app) uses this. It creates the five
# "Fleet *" custom fields and the project, then you can remove it.
# ===========================================================================
JIRA_ADMIN_TOKEN=

# Optional. Required only if the project does not exist yet.
JIRA_ACCOUNT_ID=

# ===========================================================================
# Git working directory for the worker — required.
# The repo is cloned here if it is empty. Use an ABSOLUTE path.
# ===========================================================================
FLEET_REPO=C:\Users\you\.fleet\worker-01\app

# Optional but usually wanted: the remote to clone and push to.
FLEET_REMOTE=git@bitbucket.org:your-workspace/your-repo.git

# Optional. Leave blank and the worker asks the remote for its default branch
# (`main`, `master`, ...). Set it only to override that.
# FLEET_BASE_BRANCH=main

# A name for this worker, so the board can tell workers apart.
# Defaults to worker-<hostname>.
# FLEET_WORKER_ID=worker-01

# Which harness to run. `script` is a deterministic no-op for a first test;
# `cmdc` drives Command Code; `copilot` and `kiro` are the others.
FLEET_ADAPTER=script

# ===========================================================================
# Bitbucket — optional. Without these, pull requests are recorded locally
# (`PR host: local`) instead of being opened. That is fine for a first run.
# ===========================================================================
# FLEET_BB_WORKSPACE=your-workspace
# FLEET_BB_REPO=your-repo
# FLEET_BB_USERNAME=your-bitbucket-username
# FLEET_BB_APP_PASSWORD=

# ===========================================================================
# Harness tuning — optional.
# ===========================================================================
# CMDC_PERMISSION_MODE=yolo
# CMDC_MODEL=
# COPILOT_ARGS=
# COPILOT_BIN=copilot

# ===========================================================================
# Test adapter (`FLEET_ADAPTER=script`) — optional.
# With none of these set the adapter does nothing, and the worker correctly
# refuses to open a PR with no changes ("harness produced no file changes").
# ===========================================================================
# FLEET_SCRIPT_FILE=FLEET_OUTPUT.md
# FLEET_SCRIPT_CONTENT=# done by the fleet
# FLEET_SCRIPT_MODE=ok          # ok | fail | hang
# FLEET_SCRIPT_RUN_TESTS=1
